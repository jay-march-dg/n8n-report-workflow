    {
      "parameters": {
        "jsCode": "// Pull the LLM's structured output + the building/date context\nconst out = $json.output;\n\n// Grab building/date from an upstream node (adjust node name if different)\nlet building = \"Building\", date = \"\";\ntry {\n  building = $('Combine Data Sources').item.json.building || building;\n  date = $('Combine Data Sources').item.json.date || \"\";\n} catch (e) {}\n\nconst esc = (s) => String(s ?? \"\")\n  .replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n\n// Format a nice date if possible\nlet niceDate = date;\ntry {\n  niceDate = new Date(date).toLocaleDateString(\"en-US\",\n    { weekday: \"long\", year: \"numeric\", month: \"long\", day: \"numeric\" });\n} catch (e) {}\n\nconst takeaways = (out.keyTakeaways || [])\n  .map(t => `<li style=\"margin:6px 0;\">${esc(t)}</li>`).join(\"\");\n\nconst actions = (out.actionItems || []).map(a => `\n  <tr>\n    <td style=\"padding:8px 10px;border-bottom:1px solid #e5e7eb;\">${esc(a.task)}</td>\n    <td style=\"padding:8px 10px;border-bottom:1px solid #e5e7eb;white-space:nowrap;\">${esc(a.owner)}</td>\n    <td style=\"padding:8px 10px;border-bottom:1px solid #e5e7eb;white-space:nowrap;\">${esc(a.dueDate)}</td>\n  </tr>`).join(\"\");\n\nconst followUps = (out.followUps || [])\n  .map(f => `<li style=\"margin:6px 0;\">${esc(f)}</li>`).join(\"\");\n\nconst highlights = (out.whatsNewHighlights || [])\n  .map(h => `<li style=\"margin:6px 0;\">${esc(h)}</li>`).join(\"\");\n\nconst html = `\n<div style=\"font-family:Segoe UI,Arial,sans-serif;color:#1f2937;max-width:720px;\n            margin:0 auto;padding:24px;background:#ffffff;\">\n  <div style=\"border-bottom:3px solid #2f80ed;padding-bottom:14px;margin-bottom:20px;\">\n    <h1 style=\"margin:0;font-size:22px;color:#111827;\">End-of-Day Report — ${esc(building)}</h1>\n    <div style=\"color:#6b7280;font-size:14px;margin-top:4px;\">${esc(niceDate)}</div>\n  </div>\n\n  <h2 style=\"font-size:16px;color:#2f80ed;margin:0 0 8px;\">Summary</h2>\n  <p style=\"line-height:1.6;margin:0 0 22px;\">${esc(out.summary)}</p>\n\n  ${takeaways ? `\n  <h2 style=\"font-size:16px;color:#2f80ed;margin:0 0 8px;\">Key Takeaways</h2>\n  <ul style=\"margin:0 0 22px;padding-left:20px;line-height:1.5;\">${takeaways}</ul>` : \"\"}\n\n  ${actions ? `\n  <h2 style=\"font-size:16px;color:#2f80ed;margin:0 0 10px;\">Action Items</h2>\n  <table style=\"width:100%;border-collapse:collapse;margin-bottom:22px;font-size:14px;\">\n    <thead>\n      <tr style=\"background:#f3f4f6;\">\n        <th style=\"text-align:left;padding:8px 10px;\">Task</th>\n        <th style=\"text-align:left;padding:8px 10px;\">Owner</th>\n        <th style=\"text-align:left;padding:8px 10px;\">Due</th>\n      </tr>\n    </thead>\n    <tbody>${actions}</tbody>\n  </table>` : \"\"}\n\n  ${followUps ? `\n  <h2 style=\"font-size:16px;color:#2f80ed;margin:0 0 8px;\">Follow-Ups Needed</h2>\n  <ul style=\"margin:0 0 22px;padding-left:20px;line-height:1.5;\">${followUps}</ul>` : \"\"}\n\n  ${highlights ? `\n  <h2 style=\"font-size:16px;color:#2f80ed;margin:0 0 8px;\">Highlights</h2>\n  <ul style=\"margin:0 0 22px;padding-left:20px;line-height:1.5;\">${highlights}</ul>` : \"\"}\n\n  <div style=\"border-top:1px solid #e5e7eb;margin-top:20px;padding-top:12px;\n              color:#9ca3af;font-size:12px;\">\n    Automatically generated from EPMS CX progress data and meeting notes.\n  </div>\n</div>`;\n\n// Also build a plain-text fallback\nconst plain = [\n  `End-of-Day Report — ${building}`,\n  niceDate, \"\",\n  \"SUMMARY\", out.summary, \"\",\n  \"KEY TAKEAWAYS\", ...(out.keyTakeaways || []).map(t => `• ${t}`), \"\",\n  \"ACTION ITEMS\",\n  ...(out.actionItems || []).map(a => `• ${a.task} (Owner: ${a.owner}, Due: ${a.dueDate})`), \"\",\n  \"FOLLOW-UPS\", ...(out.followUps || []).map(f => `• ${f}`),\n].join(\"\\n\");\n\nreturn [{ json: { report_html: html, report_text: plain, building, date } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
