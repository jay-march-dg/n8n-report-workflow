      "parameters": {
        "promptType": "define",
        "text": "=Generate a comprehensive End-of-Day Daily Log by analyzing the following data:\n\nBuilding: {{ $json.building }}\nDate: {{ $json.date }}\n\nOverall Status:\n{{ JSON.stringify($json.overall) }}\n\nToday's Changes Summary:\n{{ JSON.stringify($json.summary) }}\n\nToday's Changes (detail):\n{{ JSON.stringify($json.changes) }}\n\nMeeting Transcription:\n{{ $json.transcript_clean }}\n\nCreate a curated log that synthesizes both the progress data and the meeting\ntranscription into: a brief summary, key takeaways, action items with owners\nand due dates, follow-ups needed, and highlights from today's changes.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an expert executive assistant specializing in creating concise, actionable End-of-Day reports. Your role is to synthesize information from multiple sources (What's New items and meeting notes) into a well-structured daily log. Extract key takeaways, identify action items with clear ownership and deadlines, note important follow-ups, and highlight significant updates. Be concise, professional, and focus on actionable insights."
        }
      },
