    {
      "parameters": {
        "jsCode": "const raw = $json.meeting_transcription || \"\";\nconst clean = raw\n  .replace(/WEBVTT/g, \"\")\n  .replace(/[0-9a-f-]+\\/\\d+-\\d+/g, \"\")\n  .replace(/\\d{2}:\\d{2}:\\d{2}\\.\\d{3} --> .*/g, \"\")\n  .replace(/<\\/?v[^>]*>/g, \"\")\n  .replace(/\\r\\n|\\r|\\n/g, \" \")\n  .replace(/\\s{2,}/g, \" \")\n  .trim();\n\n// drop the raw transcription, keep everything else + the clean version\nconst { meeting_transcription, ...rest } = $json;\nreturn [{ json: { ...rest, transcript_clean: clean } }];"
      },
      "type": "n8n-nodes-base.code",
